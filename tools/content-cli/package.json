{
  "name": "@science-kids/content-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Science Kids content pipeline CLI (MVP): validate / import / ids on markdown lessons, tts (EN via Kokoro, VI via VieNeu), build (content pack), validate (content schema + authoring rules per age group), images search / fetch (licence-checked pictures, SK-033). publish comes later.",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "scripts": {
    "tts": "node src/cli.ts tts",
    "build": "node src/cli.ts build",
    "validate": "node src/cli.ts validate",
    "import": "node src/cli.ts import",
    "ids": "node src/cli.ts ids",
    "images": "node src/cli.ts images",
    "make-age-fixtures": "node scripts/make-age-fixtures.ts",
    "fetch-model": "node src/cli.ts fetch-model",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@science-kids/content-schema": "file:../../packages/content-schema",
    "ajv": "8.20.0",
    "kokoro-js": "1.2.1",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
