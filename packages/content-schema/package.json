{
  "name": "@science-kids/content-schema",
  "version": "0.1.0",
  "private": true,
  "description": "Science Kids content schema v1: JSON Schema (source) + zod mirror + validate script",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./validate": "./scripts/lib/core.mjs",
    "./schema/*": "./schema/*"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs fixtures/valid",
    "test": "node --test \"test/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
