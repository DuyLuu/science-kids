{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://science-kids.example/schema/content/v1/collectible.schema.json",
  "title": "Science Kids content v1: thẻ sưu tầm",
  "$ref": "#/$defs/Collectible",
  "$defs": {
    "Collectible": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/Uuid" },
        "key": { "$ref": "common.schema.json#/$defs/Key" },
        "set": { "$ref": "common.schema.json#/$defs/Key", "description": "Bộ thẻ, vd food" },
        "name": { "$ref": "common.schema.json#/$defs/Spoken" },
        "tag": { "$ref": "common.schema.json#/$defs/Spoken", "description": "vd Vitamin & khoáng chất" },
        "image": { "$ref": "common.schema.json#/$defs/Image" },
        "fact": { "$ref": "common.schema.json#/$defs/Spoken", "description": "Em có biết?" },
        "rarity": { "type": "string", "enum": ["common", "rare"], "default": "common" }
      },
      "required": ["id", "key", "set", "name", "image", "fact"],
      "additionalProperties": false
    }
  }
}
