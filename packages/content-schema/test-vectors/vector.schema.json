{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://science-kids.example/schema/test-vectors/v1/vector.schema.json",
  "title": "Science Kids · file test vector v1 (SK-003)",
  "description": "Định dạng chung cho mọi file vector trong packages/content-schema/test-vectors. Một file = một bộ (suite) = một hàm thuần.",
  "type": "object",
  "required": ["suite", "version", "source", "function", "platforms", "default_rules", "cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "suite": { "enum": ["item-scoring", "lesson-score", "stars", "streak", "local-date", "warmup-selection", "build-tray"] },
    "version": { "const": 1 },
    "source": { "type": "string", "minLength": 1 },
    "function": { "type": "string", "minLength": 1 },
    "platforms": {
      "description": "Nơi bộ này phải chạy: app (Swift + Kotlin), server (pgTAP), app_offline (app chỉ chạy nếu app tự chọn khi offline).",
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["app", "server", "app_offline"] }
    },
    "context": {
      "description": "Thông tin để kiểm chính vector (ví dụ múi giờ dùng để tính sẵn local_date). Harness không truyền vào hàm.",
      "type": "object", "additionalProperties": false,
      "properties": { "timezone": { "$ref": "#/$defs/Timezone" } }
    },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "default_rules": { "$ref": "#/$defs/Rules" },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Case" } }
  },
  "allOf": [
    { "if": { "properties": { "suite": { "const": "item-scoring" } } },
      "then": { "properties": { "cases": { "items": { "properties": {
        "id": { "pattern": "^item-scoring-[0-9]{3}$" },
        "input": { "$ref": "#/$defs/ItemScoringInput" },
        "expected": { "oneOf": [ { "$ref": "#/$defs/ItemScoringResult" }, { "$ref": "#/$defs/ItemScoringError" } ] } } } } } } },
    { "if": { "properties": { "suite": { "const": "lesson-score" } } },
      "then": { "properties": { "cases": { "items": { "properties": {
        "id": { "pattern": "^lesson-score-[0-9]{3}$" },
        "input": { "$ref": "#/$defs/LessonScoreInput" },
        "expected": { "oneOf": [ { "$ref": "#/$defs/LessonScoreResult" }, { "$ref": "#/$defs/LessonScoreError" } ] } } } } } } },
    { "if": { "properties": { "suite": { "const": "stars" } } },
      "then": { "properties": { "cases": { "items": { "properties": {
        "id": { "pattern": "^stars-[0-9]{3}$" },
        "input": { "$ref": "#/$defs/StarsInput" },
        "expected": { "$ref": "#/$defs/StarsResult" } } } } } } },
    { "if": { "properties": { "suite": { "const": "streak" } } },
      "then": { "properties": { "cases": { "items": { "properties": {
        "id": { "pattern": "^streak-[0-9]{3}$" },
        "input": { "$ref": "#/$defs/StreakInput" },
        "expected": { "$ref": "#/$defs/StreakResult" } } } } } } },
    { "if": { "properties": { "suite": { "const": "local-date" } } },
      "then": { "properties": { "cases": { "items": { "properties": {
        "id": { "pattern": "^local-date-[0-9]{3}$" },
        "input": { "$ref": "#/$defs/LocalDateInput" },
        "expected": { "$ref": "#/$defs/Date" } } } } } } },
    { "if": { "properties": { "suite": { "const": "warmup-selection" } } },
      "then": { "properties": { "cases": { "items": { "properties": {
        "id": { "pattern": "^warmup-selection-[0-9]{3}$" },
        "input": { "$ref": "#/$defs/WarmupInput" },
        "expected": { "$ref": "#/$defs/WarmupResult" } } } } } } },
    { "if": { "properties": { "suite": { "const": "build-tray" } } },
      "then": { "properties": { "cases": { "items": { "properties": {
        "id": { "pattern": "^build-tray-[0-9]{3}$" },
        "input": { "$ref": "#/$defs/BuildTrayInput" },
        "expected": { "oneOf": [ { "$ref": "#/$defs/BuildTrayResult" }, { "$ref": "#/$defs/BuildTrayError" } ] } } } } } } }
  ],
  "$defs": {
    "Date": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
    "Timestamp": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$" },
    "Timezone": { "type": "string", "pattern": "^(UTC|[A-Z][A-Za-z_]+(/[A-Z][A-Za-z_+-]+){1,2})$" },
    "Key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
    "Id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "DecisionRef": { "type": "string", "pattern": "^SK-[0-9]{3}/[DT][0-9]+$" },
    "Fraction": {
      "type": "object", "required": ["num", "den"], "additionalProperties": false,
      "properties": { "num": { "type": "integer", "minimum": 0 }, "den": { "type": "integer", "minimum": 1 } }
    },
    "Window": {
      "type": "object", "required": ["target", "min", "max"], "additionalProperties": false,
      "properties": {
        "target": { "type": "integer", "minimum": 0 },
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 0 }
      }
    },
    "WarmupRules": {
      "type": "object", "required": ["min", "max", "week", "month", "exclude_dok"], "additionalProperties": false,
      "properties": {
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 1 },
        "week": { "$ref": "#/$defs/Window" },
        "month": { "$ref": "#/$defs/Window" },
        "exclude_dok": { "type": "array", "uniqueItems": true, "items": { "enum": [1, 2, 3] } }
      }
    },
    "RuleMaxTries": { "type": "integer", "minimum": 1 },
    "RulePartialOrderMin": { "oneOf": [ { "type": "null" }, { "type": "integer", "minimum": 1 } ] },
    "RuleMasteryGapDays": { "type": "integer", "minimum": 0 },
    "RuleRestDaysPerWeek": { "type": "integer", "minimum": 0, "maximum": 6 },
    "Rules": {
      "description": "Bản sao tham số của content/rules.json (B5.3). Phải giống hệt nhau ở mọi file.",
      "type": "object",
      "required": ["max_tries", "partial_order_min", "pass_threshold", "mastery_gap_days", "rest_days_per_week", "warmup"],
      "additionalProperties": false,
      "properties": {
        "max_tries": { "$ref": "#/$defs/RuleMaxTries" },
        "partial_order_min": { "$ref": "#/$defs/RulePartialOrderMin" },
        "pass_threshold": { "$ref": "#/$defs/Fraction" },
        "mastery_gap_days": { "$ref": "#/$defs/RuleMasteryGapDays" },
        "rest_days_per_week": { "$ref": "#/$defs/RuleRestDaysPerWeek" },
        "warmup": { "$ref": "#/$defs/WarmupRules" }
      }
    },
    "RulesOverride": {
      "description": "Chỉ ghi khoá khác default_rules. Gộp nông theo khoá cấp 1 (giống jsonb ||): ghi warmup thì phải ghi đủ cả object warmup.",
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "max_tries": { "$ref": "#/$defs/RuleMaxTries" },
        "partial_order_min": { "$ref": "#/$defs/RulePartialOrderMin" },
        "pass_threshold": { "$ref": "#/$defs/Fraction" },
        "mastery_gap_days": { "$ref": "#/$defs/RuleMasteryGapDays" },
        "rest_days_per_week": { "$ref": "#/$defs/RuleRestDaysPerWeek" },
        "warmup": { "$ref": "#/$defs/WarmupRules" }
      }
    },
    "Case": {
      "type": "object",
      "required": ["id", "description", "status", "input", "expected"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string", "minLength": 20 },
        "status": { "enum": ["confirmed", "proposed"] },
        "decision": {
          "anyOf": [
            { "$ref": "#/$defs/DecisionRef" },
            { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/DecisionRef" } }
          ]
        },
        "rules": { "$ref": "#/$defs/RulesOverride" },
        "input": { "type": "object" },
        "expected": {},
        "derived": {
          "description": "Giá trị suy ra để người đọc kiểm (thứ, tuần ISO, age). Harness bỏ qua; check-vectors.mjs tính lại bằng công cụ.",
          "type": "object", "additionalProperties": false,
          "properties": {
            "calendar": {
              "type": "object",
              "propertyNames": { "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "additionalProperties": { "type": "string", "pattern": "^(Mon|Tue|Wed|Thu|Fri|Sat|Sun) [0-9]{4}-W[0-9]{2}$" }
            },
            "ages": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
          }
        }
      },
      "if": { "properties": { "status": { "const": "proposed" } } },
      "then": { "required": ["decision"] },
      "else": { "not": { "required": ["decision"] } }
    },

    "ChoiceOption": {
      "type": "object", "required": ["key", "correct"], "additionalProperties": false,
      "properties": { "key": { "$ref": "#/$defs/Key" }, "correct": { "type": "boolean" } }
    },
    "KeyOnly": {
      "type": "object", "required": ["key"], "additionalProperties": false,
      "properties": { "key": { "$ref": "#/$defs/Key" } }
    },
    "TrySelectOne": {
      "type": "object", "required": ["selected"], "additionalProperties": false,
      "properties": { "selected": { "$ref": "#/$defs/Key" } }
    },
    "TrySelectMany": {
      "type": "object", "required": ["selected"], "additionalProperties": false,
      "properties": { "selected": { "type": "array", "items": { "$ref": "#/$defs/Key" } } }
    },
    "TryValue": {
      "type": "object", "required": ["value"], "additionalProperties": false,
      "properties": { "value": { "type": "boolean" } }
    },
    "TryFilled": {
      "type": "object", "required": ["filled"], "additionalProperties": false,
      "properties": { "filled": { "type": "array", "items": { "$ref": "#/$defs/Key" } } }
    },
    "TryOrder": {
      "type": "object", "required": ["order"], "additionalProperties": false,
      "properties": { "order": { "type": "array", "items": { "$ref": "#/$defs/Key" } } }
    },
    "ItemScoringInput": {
      "oneOf": [
        { "type": "object", "required": ["item", "tries"], "additionalProperties": false,
          "properties": {
            "item": { "type": "object", "required": ["format", "options"], "additionalProperties": false,
              "properties": { "format": { "enum": ["single_choice", "picture_bar_chart"] },
                "options": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "$ref": "#/$defs/ChoiceOption" } } } },
            "tries": { "type": "array", "items": { "$ref": "#/$defs/TrySelectOne" } } } },
        { "type": "object", "required": ["item", "tries"], "additionalProperties": false,
          "properties": {
            "item": { "type": "object", "required": ["format", "options"], "additionalProperties": false,
              "properties": { "format": { "const": "multi_choice" },
                "options": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "$ref": "#/$defs/ChoiceOption" } } } },
            "tries": { "type": "array", "items": { "$ref": "#/$defs/TrySelectMany" } } } },
        { "type": "object", "required": ["item", "tries"], "additionalProperties": false,
          "properties": {
            "item": { "type": "object", "required": ["format", "answer"], "additionalProperties": false,
              "properties": { "format": { "const": "true_false" }, "answer": { "type": "boolean" } } },
            "tries": { "type": "array", "items": { "$ref": "#/$defs/TryValue" } } } },
        { "type": "object", "required": ["item", "tries"], "additionalProperties": false,
          "properties": {
            "item": { "type": "object", "required": ["format", "bank", "answers"], "additionalProperties": false,
              "properties": { "format": { "const": "fill_blank_bank" },
                "bank": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/KeyOnly" } },
                "answers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Key" } } } },
            "tries": { "type": "array", "items": { "$ref": "#/$defs/TryFilled" } } } },
        { "type": "object", "required": ["item", "tries"], "additionalProperties": false,
          "properties": {
            "item": { "type": "object", "required": ["format", "items", "answer"], "additionalProperties": false,
              "properties": { "format": { "const": "order_sequence" },
                "items": { "type": "array", "minItems": 3, "maxItems": 6, "items": { "$ref": "#/$defs/KeyOnly" } },
                "answer": { "type": "array", "minItems": 3, "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/Key" } } } },
            "tries": { "type": "array", "items": { "$ref": "#/$defs/TryOrder" } } } }
      ]
    },
    "ItemScoringResult": {
      "type": "object", "required": ["points", "try_results", "final_correct", "tries_used"], "additionalProperties": false,
      "properties": {
        "points": { "enum": [0, 1] },
        "try_results": { "type": "array", "minItems": 1, "items": { "type": "boolean" } },
        "final_correct": { "type": "boolean" },
        "tries_used": { "type": "integer", "minimum": 1 }
      }
    },
    "ItemScoringError": {
      "type": "object", "required": ["error"], "additionalProperties": false,
      "properties": { "error": { "enum": ["too_many_tries", "try_after_correct", "no_tries", "invalid_answer"] } }
    },

    "TrayBlock": {
      "description": "Phần luật của block build_tray (SK-001): chỉ key, role, group, capacity. Chữ hiển thị bỏ đi.",
      "type": "object", "required": ["capacity", "groups", "items"], "additionalProperties": false,
      "properties": {
        "capacity": { "type": "integer", "minimum": 1 },
        "groups": { "type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["key", "role"], "additionalProperties": false,
          "properties": { "key": { "$ref": "#/$defs/Key" }, "role": { "enum": ["required", "limit", "neutral"] } } } },
        "items": { "type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["key", "group"], "additionalProperties": false,
          "properties": { "key": { "$ref": "#/$defs/Key" }, "group": { "$ref": "#/$defs/Key" } } } }
      }
    },
    "BuildTrayInput": {
      "type": "object", "required": ["block", "tray", "taps"], "additionalProperties": false,
      "properties": {
        "block": { "$ref": "#/$defs/TrayBlock" },
        "tray": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "taps": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
      }
    },
    "BuildTrayResult": {
      "type": "object", "required": ["tray", "full", "missing", "has_limited", "success", "message"], "additionalProperties": false,
      "properties": {
        "tray": { "type": "array", "items": { "$ref": "#/$defs/Key" } },
        "full": { "type": "boolean" },
        "missing": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Key" } },
        "has_limited": { "type": "boolean" },
        "success": { "type": "boolean" },
        "message": { "type": "string", "pattern": "^(start|full|balanced|has_limited|missing\\.[a-z][a-z0-9_]{0,39})$" }
      }
    },
    "BuildTrayError": {
      "type": "object", "required": ["error"], "additionalProperties": false,
      "properties": { "error": { "enum": ["unknown_item", "invalid_tray"] } }
    },

    "QuizResult": {
      "type": "object", "required": ["item_id", "points", "final_correct"], "additionalProperties": false,
      "properties": { "item_id": { "$ref": "#/$defs/Id" }, "points": { "enum": [0, 1] }, "final_correct": { "type": "boolean" } }
    },
    "LessonScoreInput": {
      "type": "object", "required": ["quiz_results", "warmup_results"], "additionalProperties": false,
      "properties": {
        "quiz_results": { "type": "array", "items": { "$ref": "#/$defs/QuizResult" } },
        "warmup_results": { "type": "array", "items": { "$ref": "#/$defs/QuizResult" } }
      }
    },
    "LessonScoreResult": {
      "type": "object", "required": ["correct", "max", "completed"], "additionalProperties": false,
      "properties": {
        "correct": { "type": "integer", "minimum": 0, "maximum": 6 },
        "max": { "const": 6 },
        "completed": { "type": "boolean" }
      }
    },
    "LessonScoreError": {
      "type": "object", "required": ["error"], "additionalProperties": false,
      "properties": { "error": { "enum": ["invalid_results"] } }
    },

    "Attempt": {
      "type": "object", "required": ["attempt_id", "completed", "completed_at", "local_date", "correct", "max"], "additionalProperties": false,
      "properties": {
        "attempt_id": { "$ref": "#/$defs/Id" },
        "completed": { "type": "boolean" },
        "completed_at": { "oneOf": [ { "$ref": "#/$defs/Timestamp" }, { "type": "null" } ] },
        "local_date": { "oneOf": [ { "$ref": "#/$defs/Date" }, { "type": "null" } ] },
        "correct": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 1 }
      },
      "if": { "properties": { "completed": { "const": true } } },
      "then": { "properties": { "completed_at": { "$ref": "#/$defs/Timestamp" }, "local_date": { "$ref": "#/$defs/Date" } } },
      "else": { "properties": { "completed_at": { "type": "null" }, "local_date": { "type": "null" } } }
    },
    "StarsInput": {
      "type": "object", "required": ["attempts"], "additionalProperties": false,
      "properties": { "attempts": { "type": "array", "items": { "$ref": "#/$defs/Attempt" } } }
    },
    "StarsResult": {
      "type": "object", "required": ["stars", "first_pass_date", "mastered_date"], "additionalProperties": false,
      "properties": {
        "stars": { "enum": [0, 1, 2, 3] },
        "first_pass_date": { "oneOf": [ { "$ref": "#/$defs/Date" }, { "type": "null" } ] },
        "mastered_date": { "oneOf": [ { "$ref": "#/$defs/Date" }, { "type": "null" } ] }
      }
    },

    "StreakInput": {
      "type": "object", "required": ["studied_dates", "today"], "additionalProperties": false,
      "properties": {
        "studied_dates": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Date" } },
        "today": { "$ref": "#/$defs/Date" }
      }
    },
    "StreakResult": {
      "type": "object", "required": ["studied_days", "chain_start", "rest_days"], "additionalProperties": false,
      "properties": {
        "studied_days": { "type": "integer", "minimum": 0 },
        "chain_start": { "oneOf": [ { "$ref": "#/$defs/Date" }, { "type": "null" } ] },
        "rest_days": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Date" } }
      }
    },

    "LocalDateInput": {
      "type": "object", "required": ["completed_at", "timezone"], "additionalProperties": false,
      "properties": { "completed_at": { "$ref": "#/$defs/Timestamp" }, "timezone": { "$ref": "#/$defs/Timezone" } }
    },

    "HistoryItem": {
      "type": "object", "required": ["item_id", "slot", "order", "dok", "last_correct"], "additionalProperties": false,
      "properties": {
        "item_id": { "$ref": "#/$defs/Id" },
        "slot": { "enum": ["quiz", "warmup"] },
        "order": { "type": "integer", "minimum": 1 },
        "dok": { "enum": [1, 2, 3] },
        "last_correct": { "type": "boolean" }
      }
    },
    "HistoryLesson": {
      "type": "object", "required": ["lesson_id", "last_completed_at", "last_completed_date", "items"], "additionalProperties": false,
      "properties": {
        "lesson_id": { "$ref": "#/$defs/Id" },
        "last_completed_at": { "$ref": "#/$defs/Timestamp" },
        "last_completed_date": { "$ref": "#/$defs/Date" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/HistoryItem" } }
      }
    },
    "AuthoredWarmupItem": {
      "type": "object", "required": ["item_id", "order", "recall_from"], "additionalProperties": false,
      "properties": {
        "item_id": { "$ref": "#/$defs/Id" },
        "order": { "type": "integer", "minimum": 1 },
        "recall_from": {
          "oneOf": [
            { "type": "object", "required": ["kind"], "additionalProperties": false,
              "properties": { "kind": { "const": "prior_knowledge" } } },
            { "type": "object", "required": ["kind", "lesson_id"], "additionalProperties": false,
              "properties": { "kind": { "const": "lesson" }, "lesson_id": { "$ref": "#/$defs/Id" } } }
          ]
        }
      }
    },
    "WarmupInput": {
      "type": "object", "required": ["history", "current_lesson", "today"], "additionalProperties": false,
      "properties": {
        "history": { "type": "array", "items": { "$ref": "#/$defs/HistoryLesson" } },
        "current_lesson": {
          "type": "object", "required": ["lesson_id", "warmup"], "additionalProperties": false,
          "properties": {
            "lesson_id": { "$ref": "#/$defs/Id" },
            "warmup": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/AuthoredWarmupItem" } }
          }
        },
        "today": { "$ref": "#/$defs/Date" }
      }
    },
    "WarmupResult": {
      "type": "object", "required": ["items"], "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object", "required": ["item_id", "from", "slot"], "additionalProperties": false,
            "properties": {
              "item_id": { "$ref": "#/$defs/Id" },
              "from": { "$ref": "#/$defs/Id" },
              "slot": { "enum": ["recent", "week", "month", "fill", "recent_second", "prior_knowledge"] }
            }
          }
        }
      }
    }
  }
}
