# Copy to database/.env.local (gitignored) and fill in. Never commit the filled file, never paste it in a ticket.
# Used by `node scripts/db-apply.mjs` (SK-021, technical-plan.md B5.1). Staging only.
#
# Where: Supabase Dashboard → the staging project → "Connect" (top bar) → "Connection String" tab →
# Method "Session pooler" (port 5432; the direct host db.<ref>.supabase.co is IPv6 only, and the
# Transaction pooler on port 6543 is refused by the script). Replace [YOUR-PASSWORD] with the database
# password (Project Settings → Database → Reset database password if it is lost).

SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres

# Or, instead of SUPABASE_DB_URL, the parts (same Session pooler values):
# SUPABASE_DB_HOST=aws-<n>-<region>.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=postgres.<project-ref>
# SUPABASE_DB_PASSWORD=<db-password>
# SUPABASE_DB_NAME=postgres
